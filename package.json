{
  "name": "appfinancasfront",
  "version": "0.0.1",
  "description": "Descomplicando suas finanças",
  "productName": "FinanMap",
  "author": "matheushennriquesoares35@gmail.com",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "npm run test:unit && npm run test:theme && npm run test:avatar && npm run test:custo-fixo-despesa && npm run test:quality:a11y && npm run test:quality:performance && npm run test:quality:architecture",
    "test:avatar": "node scripts/check-avatar-experience.mjs",
    "test:avatar:release": "node scripts/check-avatar-release.mjs",
    "test:custo-fixo-despesa": "node scripts/check-custo-fixo-para-despesa.mjs",
    "test:quality:a11y": "node scripts/check-accessibility-ux.mjs",
    "test:quality:architecture": "node scripts/check-api-session-architecture.mjs",
    "test:quality:performance": "node scripts/check-dashboard-performance.mjs",
    "test:theme": "node scripts/check-dark-mode.mjs",
    "test:unit": "vitest run",
    "dev": "quasar dev",
    "build": "node scripts/validate-build-env.mjs && quasar build",
    "postinstall": "quasar prepare",
    "dockerDev": "docker-compose up --build"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "apexcharts": "^4.5.0",
    "axios": "^1.2.1",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "vue": "^3.4.18",
    "vue-router": "^4.0.12",
    "vue3-apexcharts": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.1.0",
    "@types/node": "^20.5.9",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "typescript": "~5.9.3",
    "vite-plugin-checker": "^0.14.4",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
